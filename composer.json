{
    "name": "app/kraken-futures-trade-manager",
    "description": "CLI-first Symfony trade manager for Kraken Futures manual execution workflows.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.2",
        "monolog/monolog": "^3.7",
        "symfony/clock": "^7.1 || ^8.0",
        "symfony/console": "^7.1 || ^8.0",
        "symfony/dependency-injection": "^7.1 || ^8.0",
        "symfony/dotenv": "^7.1 || ^8.0",
        "symfony/framework-bundle": "^7.1 || ^8.0",
        "symfony/http-client": "^7.1 || ^8.0",
        "symfony/lock": "^7.1 || ^8.0",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "^7.1 || ^8.0",
        "symfony/yaml": "^7.1 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.1 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.1 || ^8.0"
        }
    }
}
